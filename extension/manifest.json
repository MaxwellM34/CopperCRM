{
  "manifest_version": 3,
  "name": "Copper",
  "version": "0.1.0",
  "description": "Copper side panel auth check.",
  "permissions": ["identity", "sidePanel", "storage", "tabs"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "action": {
    "default_title": "Copper"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "service_worker.js"
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": [
        "https://linkedin.com/*",
        "https://www.linkedin.com/*",
        "https://*.linkedin.com/*",
        "http://linkedin.com/*",
        "http://www.linkedin.com/*",
        "http://*.linkedin.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
